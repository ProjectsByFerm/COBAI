# Copy this file to `.env` or `app/.env`. Both locations are gitignored.

# Local free/open-source setup with Ollama.
# Install Ollama, then pull the model:
# ollama pull qwen2.5-coder:7b

LLM_API_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5-coder:7b
# LLM_REASONING_EFFORT=low
# LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=220
LLM_TIMEOUT_SECONDS=180
LLM_PROMPT_VERSION=cobol_coach_v1
LLM_PREVIOUS_RESPONSE_ID_ENABLED=false
